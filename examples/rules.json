{
  "id": "example-rules",
  "version": "2026.09.1",
  "created_at": "2026-09-28T00:00:00Z",
  "rules": [
    {
      "id": "FMT-ELF",
      "version": "1",
      "name": "ELF container",
      "severity": "info",
      "description": "Flags every parsed ELF executable.",
      "target": "format",
      "op": "equals",
      "value": "elf"
    },
    {
      "id": "SEC-WRITE-EXEC",
      "version": "1",
      "name": "writable and executable section",
      "severity": "critical",
      "description": "A section carrying both write and execute permission is a classic indicator of self-modifying code.",
      "target": "section_perm",
      "section": "*",
      "op": "contains_all",
      "value": "wx"
    },
    {
      "id": "BYTES-SECRET",
      "version": "1",
      "name": "embedded secret marker",
      "severity": "high",
      "description": "Detects a hard-coded secret token anywhere in the file.",
      "target": "file_content",
      "op": "contains",
      "value": "SECRET"
    },
    {
      "id": "NAME-DEBUG",
      "version": "1",
      "name": "debug section present",
      "severity": "low",
      "target": "section_name",
      "op": "glob",
      "value": "*.debug*"
    }
  ]
}
